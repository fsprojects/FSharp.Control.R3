<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableMSTestRunner>true</EnableMSTestRunner>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="testconfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="TestCategories.fs" />
    <Compile Include="TestHelpers.fs" />
    <Compile Include="ProcessingOptionsTests.fs" />
    <Compile Include="ObservableTests.fs" />
    <Compile Include="ChunkTests.fs" />
    <Compile Include="BuilderTests.fs" />
    <Compile Include="AsyncObservableTests.fs" />
    <Compile Include="MapAsyncTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="MSTest" />
    <PackageReference Include="Unquote" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FSharp.Control.R3/FSharp.Control.R3.fsproj" />
  </ItemGroup>
</Project>
